# Klipper-Backup Configuration for RosetteOS
# Documentation: https://klipperbackup.xyz/configuration/
# Repository: https://github.com/Staubgeborener/klipper-backup

# GitHub Authentication
# Generate a personal access token (classic) with 'repo' scope at:
# https://github.com/settings/tokens
github_token=ghp_xxxxxxxxxxxxxxxx
github_username=USERNAME
github_repository=REPOSITORY
branch_name=main
commit_username=""
commit_email=""

# Backup paths
# By default on RosetteOS, backs up all files in /opt/printer_data/config
backupPaths=( \
"printer_data/config/*" \
)

# Files and patterns to exclude from git backup
exclude=( \
"*.swp" \
"*.tmp" \
"printer-[0-9]*_[0-9]*.cfg" \
"*.bak" \
"*.bkp" \
"*.csv" \
"*.zip" \
"klipper-backup.env" \
".env" \
"ShakeTune_results" \
)
