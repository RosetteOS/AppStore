{
  "id": "klipper-backup",
  "name": "Klipper-Backup",
  "category": "tool",
  "icon": "klipper-backup",
  "icon_url": "https://raw.githubusercontent.com/RosetteOS/AppStore/main/icons/klipper-backup.png",
  "description": "Automated git backup of Klipper and printer configuration files to GitHub. Backs up automatically in the background on boot and file changes, or manually via BACKUP_CFG.",
  "author": "Staubgeborener",
  "version": "1.3.6",
  "type": "tool",
  "is_builtin": false,
  "download_url": "https://raw.githubusercontent.com/RosetteOS/AppStore/main/packages/klipper-backup-v1.3.6.zip",
  "sha256": "47af41427467d621181bcccb772f54c7c7a945673918e470d4dfef96815e0502",
  "executable": "script.sh",
  "install_path": "/usr/data/rosetteos/apps/klipper-backup",
  "service": {
    "exec": "/usr/data/rosetteos/apps/klipper-backup/klipper-backup-service.sh",
    "priority": 60,
    "oom_score_adj": -200
  },
  "config_url": "https://raw.githubusercontent.com/RosetteOS/AppStore/main/configs/klipper-backup.cfg",
  "config_target": "macros/klipper-backup.cfg",
  "klipper_include": true,
  "output_dirs": [
    "config/macros"
  ],
  "probe_path": "/usr/data/rosetteos/apps/klipper-backup/script.sh",
  "website": "https://github.com/Staubgeborener/klipper-backup",
  "source_url": "https://github.com/Staubgeborener/klipper-backup"
}
